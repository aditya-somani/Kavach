# Copy to .env and fill in. Never commit .env.
# Multiple keys may be comma-separated; they are used round-robin with
# per-key cooldown and disable-on-auth-failure (see app/keypool.py).

# --- Groq (scam reasoning LLM) ---
GROQ_API_KEYS=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# --- Gnani (Prisma STT + Timbre TTS) ---
GNANI_API_KEYS=
GNANI_STT_URL=wss://api.vachana.ai/stt/v3/stream
GNANI_TTS_URL=https://api.vachana.ai/api/v1/tts/inference
GNANI_STT_MODEL=prisma-v3.0
GNANI_STT_LANGUAGE=hi-IN,en-IN
GNANI_STT_FORMAT=transcribe
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE=Shivani
GNANI_TTS_LANGUAGE=hi-IN

# --- LiveKit (optional telephony path, not required for the demo) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- App ---
APP_HOST=127.0.0.1
APP_PORT=8000
DB_PATH=data/kavach.db
